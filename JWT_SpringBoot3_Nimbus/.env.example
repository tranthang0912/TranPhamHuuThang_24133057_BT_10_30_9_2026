# JWT Spring Boot 3 - Nimbus JOSE + JWT
# Sao chép file này thành .env nếu công cụ chạy của bạn hỗ trợ .env,
# hoặc khai báo các biến tương ứng trong PowerShell/IDE.
# Không commit file .env có dữ liệu thật lên GitHub.

DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Secret Base64 đủ mạnh, tối thiểu 32 byte sau khi giải mã cho HS256.
JWT_SECRET_KEY=replace_with_your_base64_secret_key
